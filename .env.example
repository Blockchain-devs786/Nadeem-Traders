# =============================================
# Haraa Bazaar — Environment Variables Template
# =============================================
# Copy this file to .env and fill in your actual values.
# For production (Vercel), set these in the Vercel project dashboard under
# Settings → Environment Variables.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://..."

# --- Resend (Email Service) ---
RESEND_API_KEY="re_..."

# --- Google OAuth 2.0 (Server-side) ---
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# --- Google OAuth 2.0 (Frontend/Browser — MUST be VITE_ prefixed) ---
VITE_GOOGLE_CLIENT_ID="....apps.googleusercontent.com"

# --- Admin Notification Email ---
ADMIN_EMAIL="your-admin@example.com"

# --- App URL (used for OAuth redirects) ---
# Local: http://localhost:5173
# Vercel: https://your-app.vercel.app
APP_URL="http://localhost:5173"
